# Public (safe to expose in the browser)
NEXT_PUBLIC_SITE_URL=https://ju-tan.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_TWITTER_SITE=

# Server-only — never prefix with NEXT_PUBLIC_
RESEND_API_KEY=
EMAIL_FROM=
FROM_EMAIL=

# OpenAI provider (AI Engine). When unset, MockProvider is used.
JU_TAN_OPENAI=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000
JU_TAN_OPENAI_FALLBACK=1

# SMTP delivery. When unset, email stays prepared (no throw).
JU_TAN_EMAIL_DELIVERY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Trusted reverse proxies for invite rate-limit IP resolution.
JU_TAN_TRUST_PROXY=0
JU_TAN_TRUSTED_PROXIES=127.0.0.1,::1
JU_TAN_RATE_LIMIT_STORE=memory

# Optional distributed rate limit (not wired; contact API uses in-memory limits today)
RATE_LIMIT_URL=
NEXT_PUBLIC_ENABLE_SENTRY=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# JU-TAN Office password-protected download (server-only — never NEXT_PUBLIC_)
# Set real values in Vercel Environment Variables; do not commit secrets.
JU_TAN_DOWNLOAD_PASSWORD=
JU_TAN_DOWNLOAD_SESSION_SECRET=
# Private installer is read from the connected ju-tan-office Vercel Blob store.
# Vercel supplies its Blob credentials through the project connection.

# JU-TAN Office licensing API (server-only)
LICENSING_DATABASE_URL=
JU_TAN_LICENSE_TOKEN_SECRET=
JU_TAN_LICENSE_KEY_PEPPER=
